# Copia este archivo a ".env" y completa SOLO lo que uses. ".env" nunca se sube a GitHub (está en .gitignore).
# Nada de aquí es necesario para el paper trading básico.

# IA opcional (Fase 5). Sin clave, el bot funciona con reglas (plan B).
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-haiku-4-5-20251001
# Topes de costo/uso: la IA se apaga sola al alcanzarlos.
# ADVISOR_MAX_CALLS_DAY=24
# ADVISOR_MAX_USD_DAY=0.50
# ADVISOR_MAX_USD_MONTH=10

# Alertas por Telegram (Fase 6). Sin estos dos valores, solo se muestra en la terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NO pongas aquí claves de exchange: este proyecto no envía órdenes reales.
